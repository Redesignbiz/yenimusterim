# Brisa backend adresi — kayıt formundaki başvuru buraya POST edilir.
#
# ⛔ `NEXT_PUBLIC_` ÖNEKİ YOK ve olmamalı: istek Next.js SUNUCUSUNDAN çıkıyor
# (`src/app/app/kayit/actions.ts` bir 'use server' dosyası), tarayıcıdan değil.
# Önek eklenirse backend adresi istemci paketine gömülür — gereksiz bir sızıntı.
# Aynı sebeple backend'in CORS listesine bu formun domainini eklemek GEREKMEZ.
#
# Tanımsız bırakılırsa form başvuruyu göndermez ve kullanıcıya "iletilemedi"
# ekranı basar (sessizce başarı göstermez — eski davranış tam olarak o kusurdu).
#
# Lokal geliştirme:  http://localhost:8900
# Canlı:             https://<cloud-run-url>
BRISA_API_BASE=http://localhost:8900

# Analitik (opsiyonel) — bunlar tarayıcıda çalışıyor, o yüzden NEXT_PUBLIC_ önekli.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
